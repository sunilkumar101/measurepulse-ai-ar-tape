{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "remotion-studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "promo-video",
        "remotion",
        "studio",
        "promo-video/src/index.ts",
        "--no-open",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "docs"
      ],
      "port": 8080
    }
  ]
}