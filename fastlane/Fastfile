default_platform(:android)

platform :android do
  desc "Build the signed release bundle (needs keystore.properties)"
  lane :bundle do
    gradle(task: "clean bundleRelease")
  end

  desc "Upload AAB + full store listing to the internal testing track (as a draft)"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      release_status: "draft",
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true
    )
  end

  desc "Update only the store listing text and images"
  lane :metadata do
    upload_to_play_store(skip_upload_aab: true, skip_upload_apk: true, skip_upload_changelogs: true)
  end
end
